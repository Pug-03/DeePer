# ---- DeePer server config ----
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าตามต้องการ (ทุกค่าเป็น optional — แอปทำงานได้ทันทีโดยไม่ต้องตั้งค่า)

# พอร์ตเซิร์ฟเวอร์
PORT=4000

# ความลับสำหรับเซ็น JWT (ตั้งค่าจริงตอน deploy)
JWT_SECRET=change-this-to-a-long-random-string

# ตั้งเป็น production ตอน deploy จริง — บังคับให้ตั้ง JWT_SECRET เอง (ไม่ยอมใช้ค่า
# default) และซ่อนรหัส OTP ออกจาก response แม้ยังไม่ได้ตั้งค่า SMTP_*
# NODE_ENV=production

# โดเมนของ client ที่อนุญาตให้เรียก API นี้ได้ (คั่นด้วย , ถ้ามีหลายโดเมน)
# ไม่ตั้งค่า = อนุญาตทุกโดเมน (ค่าเริ่มต้น เหมาะกับตอน dev)
# CORS_ORIGIN=https://deeper.app

# ตั้งเป็น true ถ้า deploy อยู่หลัง reverse proxy (Render/Railway/Fly.io/nginx
# ฯลฯ — ส่วนใหญ่เป็นแบบนี้) ไม่งั้นระบบกันสแปมล็อกอิน/OTP จะเห็น IP ของผู้ใช้ทุก
# คนเป็นค่าเดียวกัน (IP ของ proxy) แล้วเอาไปรวมโควตากันหมด
# TRUST_PROXY=true

# ตำแหน่งไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น: server/deeptalk.db)
# DB_PATH=./deeptalk.db

# ---- Google OAuth (ไม่ตั้งค่า = ปุ่ม Google ถูกปิด) ----
# สร้าง OAuth Client ID (ประเภท Web) ที่ https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# ---- ส่งอีเมล OTP จริง (ไม่ตั้งค่า = OTP จะแสดงใน console ของเซิร์ฟเวอร์) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DeePer <no-reply@deeper.app>

# ---- สร้างคำถามด้วย AI (ไม่ตั้งค่า = ใช้เฉพาะคลังคำถามที่คัดสรร) ----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- สรุปผู้สนับสนุน (ส่งอีเมลรวมทุก ๆ N วัน) ----
# ผู้รับอีเมลสรุป (ถ้าไม่ตั้ง จะใช้ SMTP_USER; ถ้าไม่มีเลย = แค่พิมพ์ลง console)
# ต้องตั้ง SMTP_* ด้านบนด้วย ถึงจะส่งอีเมลจริง
SUPPORT_DIGEST_TO=
# ส่งสรุปทุกกี่วัน (ค่าเริ่มต้น 15)
# SUPPORT_DIGEST_DAYS=15
