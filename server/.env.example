# ---- DeePer server config ----
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าตามต้องการ (ทุกค่าเป็น optional — แอปทำงานได้ทันทีโดยไม่ต้องตั้งค่า)

# พอร์ตเซิร์ฟเวอร์
PORT=4000

# ความลับสำหรับเซ็น JWT (ตั้งค่าจริงตอน deploy)
JWT_SECRET=change-this-to-a-long-random-string

# ตั้งเป็น production ตอน deploy จริง — บังคับให้ตั้ง JWT_SECRET เอง (ไม่ยอมใช้ค่า
# default) และซ่อนรหัส OTP ออกจาก response แม้ยังไม่ได้ตั้งค่า SMTP_*
# NODE_ENV=production

# โดเมนของ client ที่อนุญาตให้เรียก API นี้ได้ (คั่นด้วย , ถ้ามีหลายโดเมน)
# ไม่ตั้งค่า = อนุญาตทุกโดเมน (ค่าเริ่มต้น เหมาะกับตอน dev)
# CORS_ORIGIN=https://deeper.in.th

# ตั้งเป็น true ถ้า deploy อยู่หลัง reverse proxy (Render/Railway/Fly.io/nginx
# ฯลฯ — ส่วนใหญ่เป็นแบบนี้) ไม่งั้นระบบกันสแปมล็อกอิน/OTP จะเห็น IP ของผู้ใช้ทุก
# คนเป็นค่าเดียวกัน (IP ของ proxy) แล้วเอาไปรวมโควตากันหมด
# TRUST_PROXY=true

# โฟลเดอร์เก็บข้อมูลทั้งหมด: ฐานข้อมูล, รูปที่อัปโหลด (uploads/) และภาพแจ้งปัญหา
# (private-uploads/) — ตอน deploy ให้ชี้ไปที่ disk ถาวร (Render: /var/data)
# ไม่งั้นข้อมูลหายทุกครั้งที่ deploy/restart (ค่าเริ่มต้น: โฟลเดอร์ server)
# DATA_DIR=/var/data

# ตำแหน่งไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น: DATA_DIR/deeptalk.db)
# DB_PATH=./deeptalk.db

# ---- Google OAuth (ไม่ตั้งค่า = ปุ่ม Google ถูกปิด) ----
# สร้าง OAuth Client ID (ประเภท Web) ที่ https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# ---- ส่งอีเมล OTP จริง (ไม่ตั้งค่า = OTP จะแสดงใน console ของเซิร์ฟเวอร์) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DeePer <no-reply@deeper.in.th>

# ---- สรุปผู้สนับสนุน (ส่งอีเมลรวมทุก ๆ N วัน) ----
# ผู้รับอีเมลสรุป (ถ้าไม่ตั้ง จะใช้ SMTP_USER; ถ้าไม่มีเลย = แค่พิมพ์ลง console)
# ต้องตั้ง SMTP_* ด้านบนด้วย ถึงจะส่งอีเมลจริง
SUPPORT_DIGEST_TO=
# ส่งสรุปทุกกี่วัน (ค่าเริ่มต้น 15)
# SUPPORT_DIGEST_DAYS=15

# ---- แจ้งปัญหา / บัค (ส่งอีเมลทันทีที่มีคนส่งรายงาน) ----
# ผู้รับอีเมลรายงาน (ถ้าไม่ตั้ง จะใช้ SUPPORT_DIGEST_TO แล้วค่อย SMTP_USER)
# REPORTS_TO=

# ---- หน้าแอดมิน (/admin) ----
# อีเมลที่ใช้เข้าหน้าแอดมิน และ bcrypt hash ของรหัสผ่าน (ห้ามใส่รหัสผ่านตรง ๆ)
# สร้าง hash:  node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'รหัสผ่าน'
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ---- เปิดรับสมัคร ----
# ก่อนเปิดตัว (11/11/2569 11:11 น.) สมัครได้เฉพาะคนที่มีรหัสเชิญนี้ — ตัวเลข 6 หลัก
# (หน้าสมัครให้กรอกเป็น 6 ช่องแบบ OTP · ใส่ผิด 4 ครั้งรอ 30 วินาที ผิดครบ 6 ครั้งรอ 15 นาที)
# ไม่ตั้ง = ปิดรับสมัครทั้งหมดจนถึงวันเปิดตัว · ตั้งแต่วันเปิดตัวไป ใครก็สมัครได้ ไม่ต้องใช้รหัส
# เข้าสู่ระบบด้วยบัญชีที่มีอยู่แล้วไม่ต้องใช้รหัส
# INVITE_CODE=482913
# เปลี่ยนเวลาเปิดรับสมัครทุกคน (ค่าเริ่มต้น = เวลาเปิดตัว)
# SIGNUP_OPENS_AT=2026-11-11T11:11:00+07:00
